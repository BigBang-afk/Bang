# Copy this file to .env and adjust values before running `docker compose up`.

# --- PostgreSQL ---
POSTGRES_DB=flexxsignal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# --- JWT ---
# Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters

# --- Seed accounts (created on first run only) ---
SEED_SUPERADMIN_EMAIL=admin@flexxsignal.local
SEED_SUPERADMIN_PASSWORD=change-me-superadmin-password
SEED_PREMIUM_EMAIL=demo@flexxsignal.local
SEED_PREMIUM_PASSWORD=change-me-premium-password

# --- CORS (comma-separated list consumed by docker-compose.yml) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Optional: authorized live market data provider (leave blank to keep Demo provider active) ---
MARKET_DATA_PROVIDER_ENDPOINT=
MARKET_DATA_PROVIDER_API_KEY=

# --- Optional: Telegram bot notifications ---
TELEGRAM_BOT_TOKEN=

# --- Ports exposed on the host ---
HTTP_PORT=8080
POSTGRES_PORT=5432
