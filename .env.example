# ---------------------------------------------------------------
# AI Lead Assistant - environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local - it is ignored by git.
# ---------------------------------------------------------------

# AI provider: "anthropic" or "demo".
# If left empty, the app uses "anthropic" when ANTHROPIC_API_KEY is set,
# otherwise "demo" (free, template-based messages - no AI calls).
AI_PROVIDER=

# Your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: Claude model to use. Default: claude-opus-5
# To reduce cost you can set a cheaper model, e.g. claude-sonnet-5 or claude-haiku-4-5
AI_MODEL=

# Your details - used to sign AI-generated messages.
AGENT_NAME=Your Name
AGENCY_NAME=

# Where the SQLite database file lives. Default: data/leads.db
DB_PATH=

# Load demo leads into a brand-new database. Set to "false" for a clean start.
SEED_DEMO_DATA=true

# Optional: password-protect the whole app (HTTP Basic Auth).
# STRONGLY recommended if you put this app on the internet.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
