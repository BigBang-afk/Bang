# ---------------------------------------------------------------------------
# Zarghoon Jewellers — environment variables
# Copy this file to .env.local (never commit .env.local) and fill in values.
# ---------------------------------------------------------------------------

# Supabase project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase SERVICE ROLE key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# This key bypasses Row Level Security and must never reach the browser
# bundle. Used only inside server actions / route handlers / server
# components (see src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for metadata, sitemap.xml, canonical URLs, and
# building WhatsApp share links with an absolute product URL.
NEXT_PUBLIC_SITE_URL=https://www.zarghoonjewellers.com

# WhatsApp Business number (E.164 without "+", e.g. 923001234567) used as a
# fallback if the admin has not yet set one in website_settings.
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000

# Optional: Google Analytics measurement ID (can also be set from the admin
# panel SEO settings instead).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: secret used to authorize POST /api/revalidate calls from the
# admin panel or external webhooks.
REVALIDATE_SECRET=change-me-to-a-long-random-string
