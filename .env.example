# Copy this file to .env.local for local development.
# Never commit real values — .env* is already gitignored.

# --- Supabase (required) -----------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — required for admin features
# (e.g. listing user emails via the Auth Admin API). NEVER prefix this
# with NEXT_PUBLIC_ and never import it into client-bundled code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ----------------------------------------------------------------
# Public base URL of this deployment, used for auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (Claude API) -------------------------------------------------------
# Server-only. Never expose to the browser. Required for /dashboard/ai-analysis
# and /api/ai-analysis — see src/lib/ai/client.ts. Without it, AI analysis
# requests fail with a clear "not configured" error rather than a confusing
# one; every other feature in the app works fine without this set.
ANTHROPIC_API_KEY=

# --- Payments (Stripe) — wired up in a later phase ------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Market data providers -------------------------------------------------
# Crypto is live via Binance.US's public REST API (api.binance.us) — no key
# required, nothing to configure. See src/lib/market-data/registry.ts.
#
# Forex, gold/XAUUSD and indices have no connected provider yet — no free,
# key-less source offers real intraday OHLCV for them. To add one:
#   1. Implement MarketDataProvider in src/lib/market-data/providers/<name>.ts
#   2. Add its API key below (server-only — never NEXT_PUBLIC_*)
#   3. Register it in src/lib/market-data/registry.ts AND add the market
#      type to SUPPORTED_MARKET_TYPES in src/lib/market-data/supported-markets.ts
# FOREX_DATA_API_KEY=
