# Copy this file to .env and fill in your own values.

# Postgres connection strings. On Vercel these are provided automatically by
# the Neon (or other Postgres) marketplace integration. For local development
# without Vercel, point both at your own Postgres instance (they can be the
# same URL if you don't need a separate pooled/unpooled connection).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-this-with-a-long-random-string-in-production"

# Optional: only needed if you want screenshot uploads to work outside Vercel
# without falling back to local filesystem storage. On Vercel this is set
# automatically once a Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
