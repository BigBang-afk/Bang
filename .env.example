# Copy this file to .env and fill in real values for your environment.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zarghoon_jewellers?schema=public"

# Secret used to sign session JWTs (httpOnly auth cookie).
# Generate a strong value for every environment, e.g.: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

NODE_ENV="development"
