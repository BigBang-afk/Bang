# =============================================================================
# Quotex Real Market AI Signals - Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://quotex_signals:quotex_signals@postgres:5432/quotex_signals
DATABASE_URL_SYNC=postgresql+psycopg2://quotex_signals:quotex_signals@postgres:5432/quotex_signals

# --- Redis (cache, pub/sub, celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Market data provider ---
# Provider must be an authorized independent market-data vendor.
# Supported: twelvedata | finnhub | polygon | alphavantage | mock
MARKET_DATA_PROVIDER=mock
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# --- Frontend public vars (never put secrets here) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8000

# --- Signal engine ---
SIGNAL_ENGINE_ENABLED=true
DEFAULT_TIMEZONE=UTC
MAX_DATA_LATENCY_MS=3000
SIGNAL_COOLDOWN_SECONDS=60

# --- Postgres container defaults (docker-compose) ---
POSTGRES_USER=quotex_signals
POSTGRES_PASSWORD=quotex_signals
POSTGRES_DB=quotex_signals
