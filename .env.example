# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://zarghoon:zarghoon_dev_pw@localhost:5432/zarghoon_jewellers?schema=public"

# ── Auth secrets (generate with: openssl rand -base64 48) ──────────────────
ADMIN_SESSION_SECRET="change-me-admin-secret-min-32-chars-long"
CUSTOMER_SESSION_SECRET="change-me-customer-secret-min-32-chars-long"

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Zarghoon Jewellers"

# ── File uploads ─────────────────────────────────────────────────────────
# Local disk storage used by default (public/uploads). For production, point
# this at an S3-compatible bucket and swap the storage adapter in
# src/lib/storage.ts.
UPLOADS_DIR="public/uploads"
MAX_UPLOAD_MB="8"

# ── SMS / WhatsApp provider (optional — leave blank to disable sending) ────
# The app never fakes delivery. With these unset, messages are created with
# status DRAFT/QUEUED and a clear "provider not configured" error is shown.
# Supported provider ids: "twilio", "whatsapp_cloud", "none"
MESSAGING_PROVIDER="none"

# Twilio (SMS + WhatsApp via Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WHATSAPP_FROM=""

# WhatsApp Cloud API (Meta)
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_ACCESS_TOKEN=""

# ── Seed data ────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@zarghoonjewellers.com"
SEED_ADMIN_PASSWORD="ChangeMe!12345"
