<?xml version="1.0" encoding="UTF-8" ?>
<base:AppearingContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IslamicCompanionPro.ViewModels"
             xmlns:base="clr-namespace:IslamicCompanionPro.Views.Base"
             x:Class="IslamicCompanionPro.Views.DuaDetailPage"
             x:DataType="vm:DuaDetailViewModel"
             x:Name="Root"
             Title="{Binding Title}">

    <Grid>
        <CollectionView ItemsSource="{Binding Duas}" Margin="16">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DuaDisplayItem">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,6">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" />
                            <Label Text="{Binding TextArabic}"
                                   Style="{StaticResource ArabicAyahLabelStyle}"
                                   FontSize="{Binding Source={x:Reference Root}, Path=BindingContext.FontSize}" />
                            <Label Text="{Binding Transliteration}" FontAttributes="Italic" Style="{StaticResource TranslationLabelStyle}" />
                            <Label Text="{Binding TranslationEnglish}" Style="{StaticResource TranslationLabelStyle}" />
                            <Label Text="{Binding Reference}" Style="{StaticResource SubtitleLabelStyle}" />

                            <HorizontalStackLayout Spacing="18">
                                <Label Text="{Binding IsFavorite, Converter={StaticResource FavoriteGlyphConverter}}" FontSize="20" TextColor="{StaticResource Gold}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleFavoriteCommand}"
                                                               CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Text="📋" FontSize="18">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.CopyDuaCommand}"
                                                               CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Text="📤" FontSize="18">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ShareDuaCommand}"
                                                               CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Style="{StaticResource ActivityIndicatorStyle}" />
    </Grid>
</base:AppearingContentPage>
