<?xml version="1.0" encoding="UTF-8" ?>
<base:AppearingContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IslamicCompanionPro.ViewModels"
             xmlns:base="clr-namespace:IslamicCompanionPro.Views.Base"
             x:Class="IslamicCompanionPro.Views.SplashPage"
             x:DataType="vm:SplashViewModel"
             BackgroundColor="{StaticResource IslamicGreen}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto,*" Padding="32">
        <VerticalStackLayout Grid.Row="1" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="☪" FontSize="72" TextColor="{StaticResource Gold}" HorizontalOptions="Center" />
            <Label Text="Islamic Companion Pro"
                   FontFamily="OpenSansSemibold"
                   FontSize="28"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center" />
            <Label Text="Qur'an • Duas • Prayer • Qibla"
                   FontSize="14"
                   TextColor="{StaticResource GoldLight}"
                   HorizontalOptions="Center" />
            <ActivityIndicator IsRunning="True" Color="{StaticResource Gold}" Margin="0,24,0,0" />
        </VerticalStackLayout>
    </Grid>
</base:AppearingContentPage>
