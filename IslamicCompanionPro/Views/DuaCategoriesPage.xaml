<?xml version="1.0" encoding="UTF-8" ?>
<base:AppearingContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IslamicCompanionPro.ViewModels"
             xmlns:models="clr-namespace:IslamicCompanionPro.Models"
             xmlns:base="clr-namespace:IslamicCompanionPro.Views.Base"
             x:Class="IslamicCompanionPro.Views.DuaCategoriesPage"
             x:DataType="vm:DuaCategoriesViewModel"
             x:Name="Root"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <SearchBar Grid.Row="0" Placeholder="Search duas" Text="{Binding SearchText}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding SearchResults}" IsVisible="{Binding IsSearchActive}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Dua">
                    <Border Style="{StaticResource ListItemBorderStyle}" Margin="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenDuaCommand}"
                                                   CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding TextArabic}" Style="{StaticResource ArabicAyahLabelStyle}" FontSize="18" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Categories}" IsVisible="{Binding IsSearchActive, Converter={StaticResource InverseBoolConverter}}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DuaCategory">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenCategoryCommand}"
                                                   CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🤲" FontSize="30" HorizontalOptions="Center" />
                            <Label Text="{Binding NameEnglish}" HorizontalTextAlignment="Center" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding NameArabic}" Style="{StaticResource ArabicAyahLabelStyle}" FontSize="16" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Style="{StaticResource ActivityIndicatorStyle}" />
    </Grid>
</base:AppearingContentPage>
