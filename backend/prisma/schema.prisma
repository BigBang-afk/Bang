// Zarghoon Jewellers ERP — Phase 1: Identity & Access
// Prisma schema for the identity-access module.
// See /ARCHITECTURE.md for why User / AuditLog / RBAC / Branch are designed
// as shared foundations for every future module (Product Master, POS,
// Inventory, Sales, CRM, Finance, Marketing, ...).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "audit"]
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@schema("identity")
}

enum MfaMethod {
  NONE
  TOTP

  @@schema("identity")
}

enum BranchAccessType {
  SINGLE
  MULTIPLE
  ALL

  @@schema("identity")
}

model User {
  id           String     @id @default(uuid())
  employeeCode String?    @unique // human-friendly staff reference, e.g. "ZJ-0001"
  username     String?    @unique
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)

  // MFA-ready fields (TOTP). Not enforced by default; OWNER can enable
  // per-account from Settings once that surface exists.
  mfaEnabled       Boolean   @default(false)
  mfaMethod        MfaMethod @default(NONE)
  mfaSecret        String? // set only once enrollment is confirmed
  mfaPendingSecret String? // awaiting confirmation via /mfa/enroll/confirm

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? // temporary auto-expiring lock from repeated failed logins
  lastLoginAt         DateTime?

  // Branch access foundation (Phase 2/3 build the full Branch module on top
  // of this). ALL bypasses the userBranches join entirely (used by OWNER).
  branchAccessType BranchAccessType @default(SINGLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Soft references (not FK-enforced) to the acting user, mirroring the
  // audit log's actorUserId — kept simple to avoid self-referential FK
  // ceremony while still satisfying "who created/updated this record".
  createdBy String?
  updatedBy String?

  roles               UserRole[]
  branches            UserBranch[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@index([status])
  @@map("users")
  @@schema("identity")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // system roles (e.g. OWNER) cannot be deleted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
  @@schema("identity")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique // e.g. "users.read", "products.create"
  module      String // owning module, e.g. "identity", "products" (future)
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
  @@schema("identity")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("identity")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

// Minimal branch reference so identity can attach access to it now; the
// full Branch/Warehouse module (address, contact info, settings, ...) is
// built in a later phase on top of this table.
model Branch {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserBranch[]

  @@map("branches")
  @@schema("identity")
}

model UserBranch {
  userId    String
  branchId  String
  grantedAt DateTime @default(now())
  grantedBy String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
  @@schema("identity")
}

// Backs user "sessions": the JWT access token is short-lived and
// stateless; this table is what actually makes a session revocable
// (logout, admin-forced logout, rotation-reuse detection, password-change
// invalidation).
model Session {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdByIp  String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("identity")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
  @@schema("identity")
}

// Generic, append-only audit log shared by every module (see
// ARCHITECTURE.md). Nothing in the application updates or deletes rows
// here — only AuditService.log() ever inserts.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String // e.g. "auth.login.success", "user.created", "role.assigned"
  entityType  String?
  entityId    String?
  result      String   @default("SUCCESS") // SUCCESS | FAILURE
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("audit")
}
