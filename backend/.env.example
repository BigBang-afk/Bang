# Copy to .env and fill in real values before running. Never commit .env.

# Postgres connection used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zarghoon_dev?schema=public

# Redis — rate-limit storage (and future session/cache/background job use)
REDIS_URL=redis://localhost:6379

# HTTP server
PORT=3000
NODE_ENV=development

# Public URLs (used for CORS in production and for building links, e.g. in
# password-reset emails once a mail provider is wired up)
APP_URL=http://localhost:5173
API_URL=http://localhost:3000/api/v1

# JWT access token secret + TTL (short-lived; generate a long random value
# per environment — never reuse this placeholder)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m

# Refresh token ("session") TTL — opaque token, stored hashed, rotated on
# every use
JWT_REFRESH_TTL_DAYS=7

# Password reset token TTL
PASSWORD_RESET_TTL_MINUTES=30

# Account lockout policy
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Bootstrap OWNER account created by `npm run prisma:seed` — set these to a
# real address/password before seeding, then rotate the password after
# first login. Never hard-code production credentials anywhere else.
SEED_OWNER_EMAIL=owner@zarghoon.local
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=ChangeMe123!
