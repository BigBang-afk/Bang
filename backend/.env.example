# Copy to .env and fill in real values before running.

# Postgres connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bang_dev?schema=public"

# HTTP server
PORT=3000
NODE_ENV=development

# JWT access token secret + TTL (short-lived; keep this out of source control in real deployments)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL=15m

# Refresh token TTL (opaque token, stored hashed, rotated on every use)
JWT_REFRESH_TTL_DAYS=7

# Password reset token TTL
PASSWORD_RESET_TTL_MINUTES=30

# Account lockout policy
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Bootstrap owner account created by the seed script
SEED_OWNER_EMAIL="owner@bang.local"
SEED_OWNER_PASSWORD="ChangeMe123!"
