# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/binary_options?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Market data
# Free, no key required, used for crypto pairs (BTC/USDT, ETH/USDT, ...).
# data-stream.binance.vision is the public market-data-only endpoint, which
# (unlike stream.binance.com and the trading API) isn't subject to Binance's
# country-eligibility restrictions.
BINANCE_WS_URL="wss://data-stream.binance.vision/stream"
# Paid provider required for forex/stocks (delayed data on free tiers is NOT
# acceptable for real-money settlement). Get a key at https://twelvedata.com
TWELVE_DATA_API_KEY=""
TWELVE_DATA_WS_URL="wss://ws.twelvedata.com/v1/quotes/price"

# Ethereum deposits/withdrawals
# JSON-RPC endpoint (Alchemy/Infura/etc) used to broadcast withdrawal transactions
ETH_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/your-key"
# Etherscan (or compatible, e.g. Etherscan v2 multichain) API key, used to
# poll incoming ETH/ERC20 transfers to user deposit addresses
ETHERSCAN_API_KEY=""
ETHERSCAN_API_URL="https://api.etherscan.io/api"
# USDT (ERC20) contract address (mainnet)
USDT_CONTRACT_ADDRESS="0xdAC17F958D2ee523a2206206994597C13D831ec"
# BIP39 mnemonic for the HD wallet that derives one deposit address per user
# (m/44'/60'/0'/0/{userId}) and signs withdrawals from those same addresses.
# NEVER commit a real mnemonic. Store this in a secrets manager / KMS in
# production, not in a plain .env file on a shared host.
HD_WALLET_MNEMONIC=""
# Minimum confirmations before a deposit is credited
DEPOSIT_MIN_CONFIRMATIONS=12
