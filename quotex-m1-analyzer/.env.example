# Gemini API key used to call Google's Gemini model for chart analysis.
# Get a free key (no credit card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: override the model (defaults to gemini-3.6-flash, a free-tier model)
GEMINI_MODEL=gemini-3.6-flash

# Optional: port the server listens on (defaults to 3000)
PORT=3000
