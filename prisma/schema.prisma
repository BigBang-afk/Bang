generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Direction {
  CALL
  PUT
}

enum Expiry {
  SEC15
  MIN1
}

enum SignalResult {
  PENDING
  WIN
  LOSS
}

enum SignalSource {
  LIVE
  BACKTEST
}

model Signal {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  pair            String
  expiry          Expiry
  direction       Direction
  confidence      Int
  signalStrength  String
  riskLevel       String
  trendDirection  String
  candlePressure  String
  reason          String
  entryTime       DateTime
  expiryTime      DateTime
  result          SignalResult @default(PENDING)
  source          SignalSource @default(LIVE)
  backtestRunId   String?
  backtestRun     BacktestRun? @relation(fields: [backtestRunId], references: [id])

  @@index([pair, expiry])
  @@index([createdAt])
}

model BacktestRun {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  pair            String
  expiry          Expiry
  totalTrades     Int
  wins            Int
  losses          Int
  winRate         Float
  avgConfidence   Float
  bestPair        String
  worstPair       String
  winStreak       Int
  lossStreak      Int
  trades          Signal[]
}
