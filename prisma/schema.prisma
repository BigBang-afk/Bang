// Zarghoon Jewellers AI Business OS — Phase 1 database schema.
// See DATABASE.md for entity documentation and design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authorization: Role / Permission / RolePermission
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  /// System roles (OWNER) are seeded and cannot be deleted or renamed.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable machine key, e.g. "gold_rate:create". Read via requirePermission().
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  roleId       String    @db.Uuid
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role                  Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  goldRatesCreated      GoldRate[]
  settingsUpdated       SystemSetting[]
  auditLogs             AuditLog[]
  productsCreated       Product[]
  inventoryItemsCreated InventoryItem[]
  stockMovements        StockMovement[]
  customersCreated      Customer[]
  salesCreated          Sale[]
  paymentsCreated       Payment[]
  returnsRequested      Return[]              @relation("ReturnRequestedBy")
  returnsProcessed      Return[]              @relation("ReturnProcessedBy")
  customerNotesCreated  CustomerNote[]
  customerPaymentsTaken CustomerPayment[]
  ledgerEntriesCreated  CustomerLedgerEntry[]

  @@index([roleId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Daily Gold Rate System
// ---------------------------------------------------------------------------

enum GoldPurity {
  K24
  K22
  K21
  K18
  SILVER
}

/// One immutable row per rate entry. Historical rows are never updated or
/// deleted — see GOLD-RATE-ENGINE.md for the append-only rationale. The
/// "effective" rate for a (businessDate, purity) pair is the row with the
/// latest createdAt, which lets an owner correct a same-day mistake without
/// ever mutating history.
model GoldRate {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessDate DateTime   @db.Date
  purity       GoldPurity
  ratePerGram  Decimal    @db.Decimal(14, 2)
  createdById  String     @db.Uuid
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdBy              User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  inventoryItemSnapshots InventoryItem[]

  @@index([businessDate])
  @@index([businessDate, purity, createdAt])
  @@map("gold_rates")
}

// ---------------------------------------------------------------------------
// System settings (key/value business configuration)
// ---------------------------------------------------------------------------

model SystemSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       String
  description String?
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  GOLD_RATE_CREATED
  GOLD_RATE_CORRECTED
  SETTINGS_CHANGED
  USER_CREATED
  ROLE_CHANGED
  CATEGORY_CREATED
  STOCK_CREATED
  STOCK_UPDATED
  STOCK_STATUS_CHANGED
  STOCK_ARCHIVED
  FINANCIAL_FIELDS_CHANGED
  BARCODE_GENERATED
  BARCODE_PRINTED
  SALE_COMPLETED
  DISCOUNT_APPLIED
  PAYMENT_CREATED
  INVOICE_GENERATED
  INVOICE_PRINTED
  INVOICE_DOWNLOADED
  RETURN_REQUESTED
  RETURN_APPROVED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  CUSTOMER_STATUS_CHANGED
  CUSTOMER_TYPE_CHANGED
  CUSTOMER_PAYMENT_RECEIVED
  CUSTOMER_NOTE_CREATED
  CUSTOMER_NOTE_UPDATED
  CUSTOMER_LEDGER_ADJUSTED
  CUSTOMER_EXPORTED
  VIP_SETTING_CHANGED
}

model AuditLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?     @db.Uuid
  action    AuditAction
  entity    String
  entityId  String?
  /// Non-sensitive context only. Never store passwords, tokens, or secrets here.
  metadata  Json?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2 — Inventory, Stock & ZJ Barcode System
// ---------------------------------------------------------------------------

/// Mirrors the WastageType union in src/types/gold.ts — kept in sync by hand
/// since the calculation engine's TS types are provider-agnostic on purpose.
enum WastageType {
  PERCENTAGE
  FIXED_GRAMS
}

enum StockStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  DAMAGED
  LOST
}

enum StockMovementType {
  STOCK_CREATED
  STOCK_UPDATED
  STOCK_RESERVED
  STOCK_SOLD
  STOCK_RETURNED
  STOCK_ADJUSTED
  STOCK_DAMAGED
  STOCK_LOST
  STOCK_ARCHIVED
}

model ProductCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  /// Seeded default categories — not protected from renaming, but the seed
  /// never re-creates one that was deliberately removed.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("product_categories")
}

/// A jewelry "design" — the reusable descriptive catalog entry. Physical,
/// individually-weighed pieces of this design are InventoryItem rows; most
/// designs have exactly one, but the model doesn't assume that (a design
/// can have several physical units in stock at once, each with its own
/// weight, barcode, cost, and status, since no two jewelry pieces weigh
/// exactly the same).
model Product {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  categoryId   String   @db.Uuid
  subcategory  String?
  designNumber String?
  supplier     String?
  karigar      String?
  imageUrl     String?
  notes        String?
  createdById  String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category  ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     InventoryItem[]

  @@index([categoryId])
  @@index([designNumber])
  @@index([supplier])
  @@index([karigar])
  @@map("products")
}

/// One physical, barcoded jewelry piece. This is the "stock" record the
/// spec refers to — weight, purity, wastage, a snapshot of the gold rate
/// used to cost it, charges, computed cost/pricing, and status all live
/// here. Never hard-deleted; see `archivedAt`.
model InventoryItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @db.Uuid

  purity         GoldPurity
  netWeight      Decimal     @db.Decimal(10, 3)
  wastageType    WastageType
  wastagePercent Decimal?    @db.Decimal(6, 3)
  wastageWeight  Decimal     @db.Decimal(10, 3)
  grossWeight    Decimal     @db.Decimal(10, 3)

  /// Snapshot of the gold rate actually used to cost this item — preserved
  /// forever, independent of how the daily rate moves afterward. See
  /// GOLD-RATE-ENGINE.md and INVENTORY.md "Gold rate snapshot".
  goldRatePerGram  Decimal @db.Decimal(14, 2)
  /// Optional provenance link to the GoldRate row this snapshot was read
  /// from, when the submitted rate matched today's effective rate exactly.
  /// Never the source of truth for the price — goldRatePerGram is.
  goldRateSourceId String? @db.Uuid
  goldValue        Decimal @db.Decimal(14, 2)

  makingCharge  Decimal @default(0) @db.Decimal(14, 2)
  stoneCharge   Decimal @default(0) @db.Decimal(14, 2)
  diamondCharge Decimal @default(0) @db.Decimal(14, 2)
  otherCharge   Decimal @default(0) @db.Decimal(14, 2)
  totalCost     Decimal @db.Decimal(14, 2)

  sellingPrice        Decimal @db.Decimal(14, 2)
  expectedProfit      Decimal @db.Decimal(14, 2)
  profitMarginPercent Decimal @db.Decimal(7, 2)

  status     StockStatus @default(IN_STOCK)
  /// Soft-delete/archive marker. Null = active. Archived items keep their
  /// barcode, history, and audit records forever — the barcode is never
  /// reused.
  archivedAt DateTime?

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  goldRateSource GoldRate?       @relation(fields: [goldRateSourceId], references: [id], onDelete: SetNull)
  barcode        Barcode?
  movements      StockMovement[]
  saleItems      SaleItem[]

  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@index([archivedAt])
  @@map("inventory_items")
}

/// The ZJ identifier. `sequence` is a database-generated autoincrement —
/// Postgres guarantees it is unique and monotonically increasing even under
/// concurrent inserts, and a value is never reused (Postgres sequences
/// don't roll back on a failed/aborted transaction). The human-readable
/// "ZJ-000001" code and the CODE128 scan payload are both derived from this
/// same integer at render time (src/lib/barcode-code.ts) — there is
/// deliberately only one identifier, shown two ways.
model Barcode {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequence        Int       @unique @default(autoincrement())
  inventoryItemId String    @unique @db.Uuid
  printCount      Int       @default(0)
  lastPrintedAt   DateTime?
  createdAt       DateTime  @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@map("barcodes")
}

/// Append-only movement ledger for a single InventoryItem — the audit trail
/// that will later connect to POS/Sales (reservations, sales, returns).
model StockMovement {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId String            @db.Uuid
  movementType    StockMovementType
  previousStatus  StockStatus?
  newStatus       StockStatus?
  weight          Decimal?          @db.Decimal(10, 3)
  notes           String?
  /// Structured context — e.g. { changes: { sellingPrice: { before, after } } }
  /// for an edit, never secrets.
  metadata        Json?
  userId          String?           @db.Uuid
  /// Set for STOCK_SOLD / STOCK_RETURNED movements originating from Phase 3
  /// POS/returns — added on top of the Phase 2 table (nullable, additive).
  saleId          String?           @db.Uuid
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  sale          Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([createdAt])
  @@index([saleId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Phase 3 — POS, Sales, Invoices & Barcode Checkout
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
  /// Not "actually paid" — the deferred portion of a sale, extended to the
  /// customer as credit. Always exactly equal to Sale.balanceAmount when
  /// present. See SALES.md "Payments always sum to the grand total".
  CREDIT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
}

enum ReturnStatus {
  RETURN_REQUESTED
  RETURNED
}

/// Customer record. `name` (the Phase 3 field) stays the canonical display
/// name — every Phase 3 read path (POS, invoices, sale history) already
/// depends on it — while `firstName`/`lastName` are Phase 4 additions for
/// structured data entry on the Add/Edit Customer form; the Add Customer
/// action combines them into `name` at save time rather than replacing it,
/// so nothing built in Phase 3 had to change. See CUSTOMER-CRM.md.
model Customer {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The real identity — a Postgres-native autoincrement column, exactly
  /// the Barcode/Invoice pattern. "ZJC-000001" is derived from it at read
  /// time (src/lib/customer-code.ts), never stored redundantly.
  customerCode       Int            @unique @default(autoincrement())
  name               String
  firstName          String?
  lastName           String?
  phone              String         @unique
  secondaryPhone     String?
  email              String?
  address            String?
  city               String?
  dateOfBirth        DateTime?      @db.Date
  anniversaryDate    DateTime?      @db.Date
  /// Optional, freeform, never used in any business rule — see
  /// CUSTOMER-CRM.md "Privacy".
  gender             String?
  preferredLanguage  String?
  customerType       CustomerType   @default(REGULAR)
  status             CustomerStatus @default(ACTIVE)
  /// Running total of unpaid balances — a cache of what
  /// CustomerLedgerEntry.balanceAfter would sum to, always updated in the
  /// same transaction as the ledger entry that changes it. The ledger is
  /// the source of truth; see CUSTOMER-LEDGER.md "Reconciliation".
  outstandingBalance Decimal        @default(0) @db.Decimal(14, 2)
  notes              String?
  createdById        String         @db.Uuid
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  createdBy     User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sales         Sale[]
  customerNotes CustomerNote[]
  preference    CustomerPreference?
  ledgerEntries CustomerLedgerEntry[]
  payments      CustomerPayment[]

  @@index([phone])
  @@index([name])
  @@index([city])
  @@index([customerType])
  @@index([status])
  @@index([createdAt])
  @@map("customers")
}

/// One completed POS transaction. `customerId` null means "walk-in" — Phase
/// 3 never creates a placeholder Customer row for a walk-in sale. Every
/// money field here is the authoritative, server-recalculated total; see
/// SALES.md "Sale transaction" for the full checkout flow.
model Sale {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String?  @db.Uuid
  saleDate   DateTime @default(now())

  /// Sum of every SaleItem.originalSellingPrice — before discounts.
  subtotal   Decimal @db.Decimal(14, 2)
  /// Sum of every SaleItem.discountAmount.
  discount   Decimal @default(0) @db.Decimal(14, 2)
  tax        Decimal @default(0) @db.Decimal(14, 2)
  /// subtotal - discount + tax.
  grandTotal Decimal @db.Decimal(14, 2)

  /// Sum of Payment.amount where method != CREDIT.
  paidAmount    Decimal @db.Decimal(14, 2)
  /// Sum of Payment.amount where method == CREDIT — the deferred balance.
  balanceAmount Decimal @default(0) @db.Decimal(14, 2)

  status SaleStatus @default(COMPLETED)

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     SaleItem[]
  payments  Payment[]
  invoice   Invoice?
  movements StockMovement[]

  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@map("sales")
}

/// A complete historical snapshot of one sold InventoryItem at the moment
/// of sale — every field is copied, never a live reference. Editing the
/// InventoryItem or Product later (or the daily gold rate) must never
/// change what a past invoice shows. See SALES.md.
model SaleItem {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId          String @db.Uuid
  inventoryItemId String @db.Uuid

  productName     String
  barcodeCode     String
  purity          GoldPurity
  netWeight       Decimal     @db.Decimal(10, 3)
  wastageType     WastageType
  wastagePercent  Decimal?    @db.Decimal(6, 3)
  wastageWeight   Decimal     @db.Decimal(10, 3)
  grossWeight     Decimal     @db.Decimal(10, 3)
  goldRatePerGram Decimal     @db.Decimal(14, 2)
  goldValue       Decimal     @db.Decimal(14, 2)
  makingCharge    Decimal     @db.Decimal(14, 2)
  stoneCharge     Decimal     @db.Decimal(14, 2)
  diamondCharge   Decimal     @db.Decimal(14, 2)
  otherCharge     Decimal     @db.Decimal(14, 2)

  originalSellingPrice Decimal       @db.Decimal(14, 2)
  discountType         DiscountType?
  /// The raw entered value — a percent (0-100) or a fixed amount, matching
  /// discountType. Null when discountAmount is 0.
  discountValue        Decimal?      @db.Decimal(14, 2)
  /// The actual currency discount applied — always server-recalculated
  /// from discountType + discountValue, never trusted from the client.
  discountAmount       Decimal       @default(0) @db.Decimal(14, 2)
  finalPrice           Decimal       @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  return        Return?

  @@index([saleId])
  @@index([inventoryItemId])
  @@map("sale_items")
}

/// One payment line on a Sale. A sale can have several (split payment); the
/// sum of every line, CREDIT included, always equals Sale.grandTotal
/// exactly. See SALES.md "Payments always sum to the grand total".
model Payment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId      String        @db.Uuid
  method      PaymentMethod
  amount      Decimal       @db.Decimal(14, 2)
  reference   String?
  notes       String?
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now())

  sale      Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([method])
  @@map("payments")
}

/// Tracks the printable invoice DOCUMENT lifecycle for a Sale — the same
/// pattern as Barcode for InventoryItem (Phase 2). `sequence` is the single
/// source of truth for the invoice number; "ZJ-INV-000001" is derived from
/// it at render time (src/lib/invoice-number.ts), never stored redundantly.
model Invoice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequence         Int       @unique @default(autoincrement())
  saleId           String    @unique @db.Uuid
  generatedAt      DateTime  @default(now())
  printCount       Int       @default(0)
  lastPrintedAt    DateTime?
  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@map("invoices")
}

/// Phase 3 returns foundation — deliberately two states only, no exchange
/// workflow. Requesting a return never touches inventory; only approving one
/// does (SOLD -> RETURNED via the existing Phase 2 status-transition
/// service). See SALES.md "Returns foundation".
model Return {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleItemId    String       @unique @db.Uuid
  status        ReturnStatus @default(RETURN_REQUESTED)
  reason        String?
  requestedById String       @db.Uuid
  requestedAt   DateTime     @default(now())
  processedById String?      @db.Uuid
  processedAt   DateTime?

  saleItem    SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  requestedBy User     @relation("ReturnRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  processedBy User?    @relation("ReturnProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("returns")
}

// ---------------------------------------------------------------------------
// Phase 4 — Customer CRM, Customer Ledger & Customer Intelligence
// ---------------------------------------------------------------------------

enum CustomerType {
  REGULAR
  VIP
  WHOLESALE
  CORPORATE
}

/// An ACCOUNT status, set deliberately by staff — distinct from the
/// "Inactive Customers" MARKETING SEGMENT (no completed purchase in N
/// days), which is computed, never stored, and never touches this field.
/// See CUSTOMER-SEGMENTS.md.
enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum LedgerTransactionType {
  SALE
  PAYMENT
  REFUND
  CREDIT_ADJUSTMENT
  DEBIT_ADJUSTMENT
}

/// Structured, multi-entry note history — separate from Customer.notes
/// (a single freeform field carried over from Phase 3) specifically so an
/// edit never silently overwrites what a previous staff member wrote.
model CustomerNote {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @db.Uuid
  note        String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("customer_notes")
}

/// Business preferences, not sensitive profiling — "prefers 21K gold",
/// "usually buys bridal sets". 1:1 with Customer, optional.
model CustomerPreference {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId             String      @unique @db.Uuid
  preferredCategories    String[]    @default([])
  preferredPurity        GoldPurity?
  preferredMetal         String?
  preferredPriceRangeMin Decimal?    @db.Decimal(14, 2)
  preferredPriceRangeMax Decimal?    @db.Decimal(14, 2)
  preferredContactMethod String?
  notes                  String?
  updatedAt              DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

/// The customer financial ledger — append-only, the source of truth for
/// Customer.outstandingBalance. Every row is written by
/// appendCustomerLedgerEntry() (src/services/customer-ledger.service.ts)
/// inside the same transaction as the event that caused it, so the ledger
/// and the cached balance can never drift. `referenceType`/`referenceId`
/// point at whatever caused the entry ("Sale", "CustomerPayment", ...) —
/// a plain string pair, the same polymorphic-reference pattern AuditLog
/// already uses, not a hard foreign key, since it can point at different
/// tables. See CUSTOMER-LEDGER.md.
model CustomerLedgerEntry {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String                @db.Uuid
  transactionType LedgerTransactionType
  referenceType   String
  referenceId     String
  debit           Decimal               @default(0) @db.Decimal(14, 2)
  credit          Decimal               @default(0) @db.Decimal(14, 2)
  /// The customer's running outstanding balance immediately after this
  /// entry — computed atomically alongside it, never backfilled.
  balanceAfter    Decimal               @db.Decimal(14, 2)
  description     String?
  createdById     String                @db.Uuid
  createdAt       DateTime              @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("customer_ledger_entries")
}

/// A standalone payment against a customer's outstanding balance — "Receive
/// Customer Payment" — distinct from Payment (a line item on one specific
/// Sale at checkout). A customer payment pays down accumulated credit that
/// may span several sales, so it isn't tied to a single saleId.
model CustomerPayment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String        @db.Uuid
  amount      Decimal       @db.Decimal(14, 2)
  /// CREDIT is not a valid method here — you cannot "receive a credit
  /// payment" — enforced in customer-payment.service.ts, not the schema,
  /// to avoid a near-duplicate enum.
  method      PaymentMethod
  reference   String?
  notes       String?
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId])
