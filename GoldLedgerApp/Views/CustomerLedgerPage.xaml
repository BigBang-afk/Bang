<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GoldLedgerApp.ViewModels"
             xmlns:models="clr-namespace:GoldLedgerApp.Models"
             xmlns:conv="clr-namespace:GoldLedgerApp.Converters"
             x:Class="GoldLedgerApp.Views.CustomerLedgerPage"
             x:DataType="vm:CustomerLedgerViewModel"
             x:Name="RootPage"
             Title="Customer Ledger">

	<ContentPage.Resources>
		<conv:BalanceColorConverter x:Key="BalanceColorConverter" />
		<conv:BalanceCaptionConverter x:Key="BalanceCaptionConverter" />
		<conv:InvertedBoolConverter x:Key="NotBool" />
	</ContentPage.Resources>

	<ContentPage.ToolbarItems>
		<ToolbarItem Text="＋ Add" Command="{Binding AddCustomerCommand}" />
	</ContentPage.ToolbarItems>

	<Grid RowDefinitions="Auto,Auto,*" Padding="20,12" RowSpacing="14">

		<SearchBar Grid.Row="0" Placeholder="Search customers by name or phone" Text="{Binding SearchText}" />

		<Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16">
			<Grid ColumnDefinitions="*,Auto">
				<VerticalStackLayout Grid.Column="0" Spacing="4">
					<Label Text="TOTAL OUTSTANDING" Style="{StaticResource SectionHeaderLabel}" />
					<Label Text="{Binding TotalOutstandingText}" Style="{StaticResource AmountLabel}" />
				</VerticalStackLayout>
				<Label Grid.Column="1" Text="{Binding Customers.Count, StringFormat='{0} customers'}"
				       Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
			</Grid>
		</Border>

		<Label Grid.Row="2" Text="No customers yet. Tap '＋ Add' to create one."
		       IsVisible="{Binding HasNoCustomers}"
		       Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" Margin="0,40" />

		<RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}"
		             IsVisible="{Binding HasNoCustomers, Converter={StaticResource NotBool}}">
			<CollectionView ItemsSource="{Binding Customers}">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:Customer">
						<Border Style="{StaticResource CardBorder}">
							<Border.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenCustomerCommand}"
								                       CommandParameter="{Binding .}" />
							</Border.GestureRecognizers>
							<Grid ColumnDefinitions="*,Auto">
								<VerticalStackLayout Grid.Column="0" Spacing="3">
									<Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
									<Label Text="{Binding Phone}" Style="{StaticResource MutedLabel}" />
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="End">
									<Label Text="{Binding CurrentBalance, StringFormat='{0:N2}'}"
									       FontAttributes="Bold"
									       TextColor="{Binding CurrentBalance, Converter={StaticResource BalanceColorConverter}}"
									       HorizontalTextAlignment="End" />
									<Label Text="{Binding CurrentBalance, Converter={StaticResource BalanceCaptionConverter}}"
									       Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" />
								</VerticalStackLayout>
							</Grid>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>

	</Grid>

</ContentPage>
