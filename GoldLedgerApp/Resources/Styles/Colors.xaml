                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!-- Brand: deep charcoal + 24K gold accent -->
	<Color x:Key="Gold">#D4AF37</Color>
	<Color x:Key="GoldDark">#A9812A</Color>
	<Color x:Key="GoldLight">#F1D97B</Color>

	<Color x:Key="Ink">#0F0E0C</Color>
	<Color x:Key="SurfaceDark">#17140F</Color>
	<Color x:Key="CardDark">#221E17</Color>
