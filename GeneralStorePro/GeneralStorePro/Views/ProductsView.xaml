<UserControl x:Class="GeneralStorePro.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Products" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Left" />
                    <Button Content="+ Add Product"
                            Command="{Binding AddNewCommand}"
                            Style="{StaticResource Button.Primary}"
                            HorizontalAlignment="Right" />
                </Grid>
                <TextBox DockPanel.Dock="Top"
                         Style="{StaticResource Input.TextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search by name or SKU..."
                         Margin="0,0,0,12" />

                <DataGrid ItemsSource="{Binding ProductsView}"
                          SelectedItem="{Binding SelectedProduct}"
                          Style="{StaticResource Grid.Modern}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" />
                        <DataGridTextColumn Header="Cost" Binding="{Binding PurchasePrice, StringFormat={}{0:C}}" Width="90" />
                        <DataGridTextColumn Header="Price" Binding="{Binding SalePrice, StringFormat={}{0:C}}" Width="90" />
                        <DataGridTemplateColumn Header="Stock" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Stock}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource Card}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Product Details" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,16" />
                <ScrollViewer>
                    <StackPanel DataContext="{Binding SelectedProduct}">
                        <Label Content="NAME" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="SKU" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="CATEGORY" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="UNIT" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="PURCHASE PRICE" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="SALE PRICE" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="STOCK QUANTITY" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="REORDER LEVEL" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
                <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Button Content="Delete"
                            Command="{Binding DeleteSelectedCommand}"
                            Style="{StaticResource Button.Danger}"
                            HorizontalAlignment="Left" />
                    <Button Content="Close"
                            Command="{Binding CloseEditorCommand}"
                            Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Right" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
