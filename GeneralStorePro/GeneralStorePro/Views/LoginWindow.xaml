<Window x:Class="GeneralStorePro.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeneralStorePro - Sign In"
        Width="1000" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.SidebarBg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!--  Brand panel  -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    Margin="60,0">
            <TextBlock Text="GeneralStorePro"
                       FontSize="40"
                       FontWeight="Bold"
                       Foreground="White" />
            <TextBlock Text="General store management, made simple."
                       FontSize="16"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource Brush.SidebarTextMuted}" />
            <TextBlock Text="POS billing  •  Inventory  •  Customer credit  •  Supplier ledger  •  Cash book  •  Reports"
                       FontSize="13"
                       Margin="0,24,0,0"
                       Foreground="{StaticResource Brush.SidebarTextMuted}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!--  Sign-in card  -->
        <Border Grid.Column="1"
                Background="{StaticResource Brush.CardBg}"
                CornerRadius="0">
            <StackPanel VerticalAlignment="Center" Margin="48">
                <TextBlock Text="Welcome back" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="Sign in to continue"
                           Style="{StaticResource Text.Muted}"
                           Margin="0,4,0,28" />

                <Label Content="USERNAME" />
                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource Input.TextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <Label Content="PASSWORD" Margin="0,16,0,4" />
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource Input.PasswordBox}"
                             PasswordChanged="PasswordBox_PasswordChanged" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <Button Content="Sign In"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Stretch"
                        Margin="0,24,0,0" />

                <TextBlock Text="Default admin login: admin / admin123"
                           Style="{StaticResource Text.Muted}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
