<UserControl x:Class="GeneralStorePro.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Reports" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,16" />

            <TabControl BorderThickness="0" Background="Transparent">
                <TabItem Header="Sales">
                    <StackPanel Margin="0,16,0,0">
                        <UniformGrid Rows="1" Columns="3" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="TOTAL SALES TODAY" Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="{Binding TotalSalesToday, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="TOTAL PURCHASES TODAY" Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="{Binding TotalPurchasesToday, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="GROSS PROFIT TODAY" Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="{Binding GrossProfitToday, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.Success}" />
                            </StackPanel>
                        </UniformGrid>
                        <DataGrid ItemsSource="{Binding RecentSales}" Style="{StaticResource Grid.Modern}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:g}}" Width="160" />
                                <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="120" />
                                <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Stock">
                    <DataGrid Margin="0,16,0,0" ItemsSource="{Binding StockLevels}" Style="{StaticResource Grid.Modern}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="120" />
                            <DataGridTextColumn Header="Reorder Level" Binding="{Binding ReorderLevel}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Customer Dues">
                    <DataGrid Margin="0,16,0,0" ItemsSource="{Binding CustomerDues}" Style="{StaticResource Grid.Modern}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Balance Due" Binding="{Binding Balance, StringFormat={}{0:C}}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Supplier Dues">
                    <DataGrid Margin="0,16,0,0" ItemsSource="{Binding SupplierDues}" Style="{StaticResource Grid.Modern}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Balance Due" Binding="{Binding Balance, StringFormat={}{0:C}}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
