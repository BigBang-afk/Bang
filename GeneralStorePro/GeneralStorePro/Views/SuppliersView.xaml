<UserControl x:Class="GeneralStorePro.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Suppliers" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Left" />
                    <Button Content="+ Add Supplier"
                            Command="{Binding AddNewCommand}"
                            Style="{StaticResource Button.Primary}"
                            HorizontalAlignment="Right" />
                </Grid>
                <TextBox DockPanel.Dock="Top"
                         Style="{StaticResource Input.TextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search by name or phone..."
                         Margin="0,0,0,12" />

                <DataGrid ItemsSource="{Binding SuppliersView}"
                          SelectedItem="{Binding SelectedSupplier}"
                          Style="{StaticResource Grid.Modern}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*" />
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*" />
                        <DataGridTextColumn Header="Balance Due" Binding="{Binding CurrentBalance, StringFormat={}{0:C}}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding CurrentBalance, Converter={StaticResource PositiveAmountToBrushConverter}}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource Card}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Supplier Details" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,16" />

                <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Button Content="Delete"
                            Command="{Binding DeleteSelectedCommand}"
                            Style="{StaticResource Button.Danger}"
                            HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close"
                                Command="{Binding CloseEditorCommand}"
                                Style="{StaticResource Button.Secondary}"
                                Margin="0,0,8,0" />
                        <Button Content="Save"
                                Command="{Binding SaveSupplierCommand}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer>
                    <StackPanel>
                        <StackPanel DataContext="{Binding Editor}">
                            <Label Content="NAME" />
                            <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <Label Content="PHONE" Margin="0,12,0,4" />
                            <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

                            <Label Content="ADDRESS" Margin="0,12,0,4" />
                            <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Visibility="{Binding DataContext.IsNewSupplier, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Label Content="OPENING BALANCE" Margin="0,12,0,4" />
                                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding OpeningBalance, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource Brush.Success}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
