<UserControl x:Class="GeneralStorePro.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Expenses" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0">
                            <Run Text="Total:" />
                            <Run Text="{Binding TotalExpenses, StringFormat={}{0:C}, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <Button Content="+ Add Expense"
                            Command="{Binding AddNewCommand}"
                            Style="{StaticResource Button.Primary}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top" />
                </Grid>

                <DataGrid ItemsSource="{Binding Expenses}"
                          SelectedItem="{Binding SelectedExpense}"
                          Style="{StaticResource Grid.Modern}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, StringFormat={}{0:d}}" Width="110" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="100" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource Card}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Expense Details" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,16" />
                <ScrollViewer>
                    <StackPanel DataContext="{Binding SelectedExpense}">
                        <Label Content="DATE" />
                        <DatePicker SelectedDate="{Binding ExpenseDate, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="CATEGORY" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="DESCRIPTION" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="PAYMENT METHOD" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="AMOUNT" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
                <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Button Content="Delete"
                            Command="{Binding DeleteSelectedCommand}"
                            Style="{StaticResource Button.Danger}"
                            HorizontalAlignment="Left" />
                    <Button Content="Close"
                            Command="{Binding CloseEditorCommand}"
                            Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Right" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
