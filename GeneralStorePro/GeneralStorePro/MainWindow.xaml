<Window x:Class="GeneralStorePro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeneralStorePro"
        Width="1360" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar  -->
        <Border Grid.Column="0" Background="{StaticResource Brush.SidebarBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock Text="GeneralStorePro"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Store Management"
                               FontSize="11"
                               Foreground="{StaticResource Brush.SidebarTextMuted}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12,0,12,16" Padding="12" Background="{StaticResource Brush.SidebarHover}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUserName}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <Button Content="Logout"
                                Command="{Binding LogoutCommand}"
                                Style="{StaticResource Button.Secondary}"
                                Foreground="{StaticResource Brush.SidebarText}"
                                Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         Style="{StaticResource Sidebar.NavList}"
                         ItemContainerStyle="{StaticResource Sidebar.NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="16" Width="28" />
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!--  Content  -->
        <ContentControl Grid.Column="1"
                         Content="{Binding CurrentViewModel}"
                         Margin="28" />
    </Grid>
</Window>
