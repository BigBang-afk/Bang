Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 500 /500.php

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deny access to sensitive files, including common backup-file patterns
# left behind by editors, manual "just in case" copies, or a downloaded
# database export that was accidentally saved into the web root.
<FilesMatch "\.(sql|log|env|md|bak|backup|old|orig|zip|tar|gz|tar\.gz|sql\.gz)$">
    Require all denied
</FilesMatch>
<Files "database.sql">
    Require all denied
</Files>

# Deny direct access to dotfiles (.git, .env, .gitignore, etc.) - a leaked
# .git directory on a live server lets anyone reconstruct the full source
# history, so this is blocked outright rather than relying on it simply
# not being uploaded.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct browser requests into folders that are only ever meant
    # to be reached via PHP's own require/require_once (never via a URL).
    # This does not affect require()/require_once() calls, which are
    # filesystem operations Apache never sees - only direct HTTP requests
    # like GET /config/config.php are blocked.
    RewriteRule ^(config|includes|database|cron)/ - [F,L]

    # HTTPS redirect - commented out by default. Uncomment ONLY after you
    # have confirmed SSL is installed and working (see DEPLOYMENT.md),
    # and only ever redirect to ONE canonical host (with or without
    # "www.", pick one) to avoid a redirect loop. HTTP_X_FORWARDED_PROTO
    # is checked too because many hosts terminate SSL at a load balancer
    # in front of Apache, where %{HTTPS} alone would never show "on" even
    # on a real HTTPS request - forcing the redirect there causes an
    # infinite redirect loop, which is why this is opt-in, not default.
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Dynamic robots.txt / sitemap.xml (always reflect current BASE_URL and live products)
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Clean product URLs: /product/some-product-slug -> product.php?slug=some-product-slug
    RewriteRule ^product/([A-Za-z0-9-]+)/?$ product.php?slug=$1 [L,QSA]

    # Clean category URLs: /category/rings -> category.php?slug=rings
    RewriteRule ^category/([A-Za-z0-9-]+)/?$ category.php?slug=$1 [L,QSA]

    # Clean collection URLs: /collections/bridal -> collections.php?slug=bridal
    RewriteRule ^collections/([A-Za-z0-9-]+)/?$ collections.php?slug=$1 [L,QSA]
</IfModule>
