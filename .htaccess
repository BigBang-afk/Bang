Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deny access to sensitive files
<FilesMatch "\.(sql|log|env|md)$">
    Require all denied
</FilesMatch>
<Files "database.sql">
    Require all denied
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dynamic robots.txt / sitemap.xml (always reflect current BASE_URL and live products)
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Clean product URLs: /product/some-product-slug -> product.php?slug=some-product-slug
    RewriteRule ^product/([A-Za-z0-9-]+)/?$ product.php?slug=$1 [L,QSA]

    # Clean category URLs: /category/rings -> category.php?slug=rings
    RewriteRule ^category/([A-Za-z0-9-]+)/?$ category.php?slug=$1 [L,QSA]

    # Clean collection URLs: /collections/bridal -> collections.php?slug=bridal
    RewriteRule ^collections/([A-Za-z0-9-]+)/?$ collections.php?slug=$1 [L,QSA]
</IfModule>
