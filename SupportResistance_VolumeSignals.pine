//@version=5
indicator("Support & Resistance + Volume Signals", overlay=true, max_lines_count=500, max_labels_count=500)

// ───────────────────────────── Inputs ─────────────────────────────
grpPivot = "Pivot / Level Detection"
pivotLeft      = input.int(5, "Pivot Left Bars", minval=1, group=grpPivot)
pivotRight     = input.int(5, "Pivot Right Bars", minval=1, group=grpPivot)
maxLevels      = input.int(12, "Max Levels Tracked", minval=1, maxval=40, group=grpPivot)
mergeTolPct    = input.float(0.25, "Merge Tolerance (% of price)", minval=0.01, step=0.05, group=grpPivot) / 100
staleBars      = input.int(300, "Expire Level After N Bars Untouched", minval=20, group=grpPivot)

grpStrength = "Strength / Signals"
strongPct      = input.int(70, "Strong Level Threshold (%)", minval=1, maxval=100, group=grpStrength)
volMALen       = input.int(20, "Volume MA Length", minval=1, group=grpStrength)
volSpikeMult   = input.float(1.5, "Volume Spike Multiplier (breakout)", minval=1.0, step=0.1, group=grpStrength)
touchTolPct    = input.float(0.15, "Touch Tolerance (% of price)", minval=0.01, step=0.05, group=grpStrength) / 100
wickPctMin     = input.float(40, "Min Rejection Wick % of Range", minval=0, maxval=100, group=grpStrength)
onlyStrongSig  = input.bool(false, "Signals Only on Strong Levels", group=grpStrength)

grpStyle = "Style"
resColor    = input.color(color.new(color.red, 20), "Resistance Color", group=grpStyle)
supColor    = input.color(color.new(color.green, 20), "Support Color", group=grpStyle)
strongGlow  = input.color(color.new(color.yellow, 60), "Strong Level Highlight", group=grpStyle)
showLabels  = input.bool(true, "Show Level Labels", group=grpStyle)

// ───────────────────────────── Level type ─────────────────────────────
type SRLevel
    float price
    int   touches
    float volSum
    bool  isResistance
    int   createdBar
    int   lastBar
    line  lineId
    label lblId

var array<SRLevel> levels = array.new<SRLevel>()

curVolMA = ta.sma(volume, volMALen)

// ───────────────────────────── Pivot detection ─────────────────────────────
ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

// Strength score: up to 80 pts from touch count (20 pts/touch, capped at 4),
// plus up to 20 pts bonus when the average volume seen at those touches
// runs at least 1.5x above the current volume MA.
f_score(_touches, _volSum) =>
    volRatio  = curVolMA > 0 ? (_volSum / _touches) / curVolMA : 1.0
    touchPts  = math.min(80.0, _touches * 20.0)
    volPts    = math.min(20.0, math.max(0.0, (volRatio - 1.0) / 0.5 * 20.0))
    math.min(100.0, touchPts + volPts)

f_registerPivot(float pivotPrice, float pivotVol, bool isRes) =>
    int foundIdx = -1
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            lvl = array.get(levels, i)
            if lvl.isResistance == isRes and math.abs(lvl.price - pivotPrice) <= pivotPrice * mergeTolPct
                foundIdx := i
                break
    if foundIdx >= 0
        lvl = array.get(levels, foundIdx)
        lvl.price      := (lvl.price * lvl.touches + pivotPrice) / (lvl.touches + 1)
        lvl.touches    := lvl.touches + 1
        lvl.volSum     := lvl.volSum + pivotVol
        lvl.lastBar    := bar_index
    else
        newLvl = SRLevel.new(pivotPrice, 1, pivotVol, isRes, bar_index, bar_index, na, na)
        if array.size(levels) >= maxLevels
            int worstIdx = 0
            float worstScore = 1e10
            for i = 0 to array.size(levels) - 1
                l = array.get(levels, i)
                s = f_score(l.touches, l.volSum)
                if s < worstScore
                    worstScore := s
                    worstIdx := i
            worst = array.get(levels, worstIdx)
            if not na(worst.lineId)
                line.delete(worst.lineId)
            if not na(worst.lblId)
                label.delete(worst.lblId)
            array.remove(levels, worstIdx)
        array.push(levels, newLvl)
    true

if not na(ph)
    f_registerPivot(ph, volume[pivotRight], true)
if not na(pl)
    f_registerPivot(pl, volume[pivotRight], false)

// ───────────────────────────── Expire stale levels ─────────────────────────────
if array.size(levels) > 0
    for i = array.size(levels) - 1 to 0
        lvl = array.get(levels, i)
        if bar_index - lvl.lastBar > staleBars
            if not na(lvl.lineId)
                line.delete(lvl.lineId)
            if not na(lvl.lblId)
                label.delete(lvl.lblId)
            array.remove(levels, i)

// ───────────────────────────── Draw levels & aggregate signals ─────────────────────────────
var bool bullishBreakout = false
var bool bearishBreakout = false
var bool bullishRejection = false
var bool bearishRejection = false
bullishBreakout := false
bearishBreakout := false
bullishRejection := false
bearishRejection := false

if array.size(levels) > 0
    for i = 0 to array.size(levels) - 1
        lvl = array.get(levels, i)
        score = f_score(lvl.touches, lvl.volSum)
        isStrong = score >= strongPct
        lineColor = lvl.isResistance ? resColor : supColor
        lineWidth = isStrong ? 3 : 1

        if na(lvl.lineId)
            lvl.lineId := line.new(lvl.createdBar, lvl.price, bar_index, lvl.price, color=lineColor, width=lineWidth, style=isStrong ? line.style_solid : line.style_dashed)
        else
            line.set_xy1(lvl.lineId, lvl.createdBar, lvl.price)
            line.set_xy2(lvl.lineId, bar_index, lvl.price)
            line.set_color(lvl.lineId, lineColor)
            line.set_width(lvl.lineId, lineWidth)
            line.set_style(lvl.lineId, isStrong ? line.style_solid : line.style_dashed)

        if showLabels
            if not na(lvl.lblId)
                label.delete(lvl.lblId)
            labTxt = (lvl.isResistance ? "R " : "S ") + str.tostring(lvl.price, format.mintick) + "  " + str.tostring(int(math.round(score))) + "%" + (isStrong ? "  STRONG" : "")
            lvl.lblId := label.new(bar_index, lvl.price, labTxt, xloc.bar_index, yloc.price, color=color.new(isStrong ? strongGlow : lineColor, isStrong ? 20 : 70), textcolor=isStrong ? color.black : color.white, style=lvl.isResistance ? label.style_label_down : label.style_label_up, size=size.small)

        // Signal eligibility
        eligible = onlyStrongSig ? isStrong : true
        if eligible
            tol = lvl.price * touchTolPct
            barRange = high - low
            if lvl.isResistance
                // Breakout above resistance
                if ta.crossover(close, lvl.price) and volume > curVolMA * volSpikeMult
                    bullishBreakout := true
                // Rejection at resistance: wicks into/above the level but closes back below with volume
                upperWick = high - math.max(close, open)
                if high >= lvl.price - tol and close < lvl.price and close < open and volume > curVolMA * volSpikeMult and barRange > 0 and (upperWick / barRange) * 100 >= wickPctMin
                    bearishRejection := true
            else
                // Breakdown below support
                if ta.crossunder(close, lvl.price) and volume > curVolMA * volSpikeMult
                    bearishBreakout := true
                // Rejection at support: wicks into/below the level but closes back above with volume
                lowerWick = math.min(close, open) - low
                if low <= lvl.price + tol and close > lvl.price and close > open and volume > curVolMA * volSpikeMult and barRange > 0 and (lowerWick / barRange) * 100 >= wickPctMin
                    bullishRejection := true

// ───────────────────────────── Plot signals ─────────────────────────────
plotshape(bullishBreakout, title="Bullish Breakout", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="B/O")
plotshape(bearishBreakout, title="Bearish Breakdown", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="B/D")
plotshape(bullishRejection, title="Bullish Rejection", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.small, text="REJ")
plotshape(bearishRejection, title="Bearish Rejection", style=shape.labeldown, location=location.abovebar, color=color.new(color.maroon, 0), textcolor=color.white, size=size.small, text="REJ")

alertcondition(bullishBreakout, title="Bullish Breakout", message="{{ticker}}: bullish breakout above resistance with volume spike")
alertcondition(bearishBreakout, title="Bearish Breakdown", message="{{ticker}}: bearish breakdown below support with volume spike")
alertcondition(bullishRejection, title="Bullish Rejection", message="{{ticker}}: bullish rejection at support with volume spike")
alertcondition(bearishRejection, title="Bearish Rejection", message="{{ticker}}: bearish rejection at resistance with volume spike")
