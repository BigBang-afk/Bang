// Prisma schema for the AI Trading platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum SignalDirection {
  LONG
  SHORT
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  status       AccountStatus @default(ACTIVE)
  avatarColor  String        @default("#22c55e")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?

  watchlist WatchlistItem[]
  signals   Signal[]
}

model WatchlistItem {
  id        String   @id @default(cuid())
  symbol    String
  label     String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, symbol])
}

// One run of the multi-strategy AI confluence engine for a pair/timeframe.
model Signal {
  id        String          @id @default(cuid())
  symbol    String
  timeframe String
  direction SignalDirection
  price     Float

  confidence      Int
  agreeingCount   Int
  totalStrategies Int

  entry       Float?
  stopLoss    Float?
  takeProfit1 Float?
  takeProfit2 Float?
  takeProfit3 Float?
  atr         Float?

  backtestWinRate    Int?
  backtestSampleSize Int?

  // Array of { key, name, vote, weight, note } — the full strategy breakdown.
  strategyBreakdown Json

  createdAt DateTime @default(now())

  requestedBy   User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  requestedById String?

  @@index([symbol, createdAt])
}
