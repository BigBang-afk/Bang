<UserControl x:Class="TradingJournal.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="USD to PKR Rate" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding UsdToPkrRateText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Gold Rate (PKR per unit below)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding GoldRateText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Gold Unit Label (e.g. Tola, Gram, Ounce)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding GoldUnitLabel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <Button Content="Save Settings" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessTextStyle}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
