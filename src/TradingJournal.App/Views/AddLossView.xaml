<UserControl x:Class="TradingJournal.App.Views.AddLossView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Add Loss" Style="{StaticResource PageTitleStyle}" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Customer (optional)" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCustomer}" Margin="0,0,0,14" />

                <TextBlock Text="Amount (USD)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding PreviewText}" Foreground="{StaticResource LossBrush}" Margin="0,0,0,14" />

                <TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding Date}" Margin="0,0,0,14" />

                <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,0,0,16" />

                <Button Content="Save Loss" Background="{StaticResource LossBrush}"
                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
