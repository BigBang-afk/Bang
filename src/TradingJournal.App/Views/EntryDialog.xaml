<Window x:Class="TradingJournal.App.Views.EntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />

        <TextBlock Text="Type" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox ItemsSource="{Binding EntryTypes}" SelectedItem="{Binding SelectedEntryType}" Margin="0,0,0,12" />

        <TextBlock Text="Customer (optional)" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedCustomer}" Margin="0,0,0,12" />

        <TextBlock Text="Amount (USD)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding PreviewText}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

        <TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}" />
        <DatePicker SelectedDate="{Binding Date}" Margin="0,0,0,12" />

        <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button Content="Save" Width="90" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
    </StackPanel>
</Window>
