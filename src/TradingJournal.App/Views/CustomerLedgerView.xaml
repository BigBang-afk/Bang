<UserControl x:Class="TradingJournal.App.Views.CustomerLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Customers" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Add Customer" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />
                    <TextBlock Text="Phone (optional)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />
                    <Button Content="Add" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddCustomerCommand}" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <ListBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name"
                         SelectedItem="{Binding SelectedCustomer}" BorderThickness="0" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontSize="22" FontWeight="Bold" VerticalAlignment="Center">
                    <Run Text="Ledger — " />
                    <Run Text="{Binding SelectedCustomer.Name}" />
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Add Profit" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AddProfitCommand}" />
                    <Button Content="Add Loss" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AddLossCommand}" />
                    <Button Content="Print Statement" Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                            Command="{Binding PreviewReportCommand}" />
                </StackPanel>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL PROFIT (PKR)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding TotalProfitPkr, StringFormat={}Rs {0:N2}}"
                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL LOSS (PKR)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding TotalLossPkr, StringFormat={}Rs {0:N2}}"
                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource LossBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="NET BALANCE (PKR)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding NetPkr, StringFormat={}Rs {0:N2}}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="NET (GOLD)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding NetGold, StringFormat={}{0:N4}}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeight="34" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Entry.Date, StringFormat={}{0:dd-MMM-yyyy}}" Width="120" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Entry.Type}" Width="80" />
                        <DataGridTextColumn Header="USD" Binding="{Binding Entry.AmountUsd, StringFormat={}${0:N2}}" Width="100" />
                        <DataGridTextColumn Header="PKR" Binding="{Binding Entry.AmountPkr, StringFormat={}Rs {0:N2}}" Width="130" />
                        <DataGridTextColumn Header="Gold" Binding="{Binding Entry.AmountGold, StringFormat={}{0:N4}}" Width="100" />
                        <DataGridTextColumn Header="Running Balance (PKR)" Binding="{Binding RunningBalancePkr, StringFormat={}Rs {0:N2}}" Width="160" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Entry.Notes}" Width="*" />
                        <DataGridTemplateColumn Header="Actions" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Style="{StaticResource GridActionButtonStyle}"
                                                Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Delete" Style="{StaticResource GridActionButtonStyle}"
                                                Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
