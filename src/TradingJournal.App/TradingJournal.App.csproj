<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TradingJournal.App</RootNamespace>
    <AssemblyName>TradingJournal</AssemblyName>
    <!-- Lets the project build (compile-only) on non-Windows machines/CI; irrelevant on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TradingJournal.Core\TradingJournal.Core.csproj" />
  </ItemGroup>

</Project>
