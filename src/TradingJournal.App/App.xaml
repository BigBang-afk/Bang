<Application x:Class="TradingJournal.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:TradingJournal.App.Common">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <common:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
