<UserControl x:Class="ZarghoonJewellers.App.Views.KarigarManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Karigar Management" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Add, edit and manage the Karigars who work with your shop" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Entry form -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TxtFormTitle" Text="Add Karigar" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource InputTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mobile Number" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtMobile" Style="{StaticResource InputTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtAddress" Style="{StaticResource InputTextBox}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNotes" Style="{StaticResource InputTextArea}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnClear" Content="Clear" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnClear_Click"/>
                        <Button x:Name="BtnSave" Content="Save Karigar" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Search Karigar (name or mobile)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtSearch" Style="{StaticResource InputTextBox}" Width="320" HorizontalAlignment="Left"
                     TextChanged="TxtSearch_TextChanged"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="KarigarsGrid" Style="{StaticResource ProDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="Mobile Number" Binding="{Binding Mobile}" Width="160"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="220"/>
                    <DataGridTextColumn Header="Added On" Binding="{Binding CreatedAt, StringFormat=dd-MMM-yyyy}" Width="110"/>
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                            Margin="0,0,6,0" Click="EditRow_Click"/>
                                    <Button Content="Delete" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11"
                                            Click="DeleteRow_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
