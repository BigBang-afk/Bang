<UserControl x:Class="ZarghoonJewellers.App.Views.KarigarLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZarghoonJewellers.App.Views">
    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Karigar Ledger" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Complete transaction history and running balance for one Karigar" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Karigar selector + print -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Select Karigar" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbKarigar" Style="{StaticResource InputComboBox}" DisplayMemberPath="Name"
                          SelectionChanged="CmbKarigar_SelectionChanged"/>
            </StackPanel>

            <Button Grid.Column="2" x:Name="BtnPrint" Content="Print A4 Report" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Bottom" Padding="20,10" Click="BtnPrint_Click"/>
        </Grid>

        <TextBlock x:Name="TxtNoSelection" Grid.Row="2" Text="Select a Karigar above to view their ledger."
                   Style="{StaticResource PageSubtitle}" FontSize="14" Margin="0,20,0,0"/>

        <StackPanel x:Name="PnlContent" Grid.Row="2" Visibility="Collapsed">
            <!-- Summary cards -->
            <WrapPanel Margin="0,0,0,16">
                <Border Style="{StaticResource CardBorder}" Width="255" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="GOLD PAYABLE" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="TxtGoldPayable" Text="0.000 g" Style="{StaticResource CardValue}" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="Shop owes Karigar" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="255" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="GOLD RECEIVABLE" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="TxtGoldReceivable" Text="0.000 g" Style="{StaticResource CardValue}" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="Karigar owes Shop" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="255" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="CASH PAYABLE" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="TxtCashPayable" Text="0.00" Style="{StaticResource CardValue}" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="Shop owes Karigar" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="255" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="CASH RECEIVABLE" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="TxtCashReceivable" Text="0.00" Style="{StaticResource CardValue}" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="Karigar owes Shop" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>

        <local:DateFilterBar x:Name="Filter" Grid.Row="3" Margin="0,0,0,14" FilterChanged="Filter_FilterChanged"/>

        <Border x:Name="BrdGrid" Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0" Visibility="Collapsed">
            <DataGrid x:Name="LedgerGrid" Style="{StaticResource ProDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MMM-yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="90"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="160"/>
                    <DataGridTextColumn Header="Gold In" Binding="{Binding GoldIn, StringFormat={}{0:N3}}" Width="80"/>
                    <DataGridTextColumn Header="Gold Out" Binding="{Binding GoldOut, StringFormat={}{0:N3}}" Width="80"/>
                    <DataGridTextColumn Header="Gold Bal" Binding="{Binding GoldBalance, StringFormat={}{0:N3}}" Width="90"/>
                    <DataGridTextColumn Header="Cash In" Binding="{Binding CashIn, StringFormat={}{0:N2}}" Width="90"/>
                    <DataGridTextColumn Header="Cash Out" Binding="{Binding CashOut, StringFormat={}{0:N2}}" Width="90"/>
                    <DataGridTextColumn Header="Cash Bal" Binding="{Binding CashBalance, StringFormat={}{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
