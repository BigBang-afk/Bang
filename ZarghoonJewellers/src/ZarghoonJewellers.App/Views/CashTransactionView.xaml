<UserControl x:Class="ZarghoonJewellers.App.Views.CashTransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZarghoonJewellers.App.Views">
    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TxtPageTitle" Text="Cash In" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="TxtPageSubtitle" Text="Record money received by the shop" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Entry form -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TxtFormTitle" Text="New Entry" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DpDate" Style="{StaticResource InputDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Person / Karigar" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbPerson" Style="{StaticResource InputComboBox}" IsEditable="True"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtDescription" Style="{StaticResource InputTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Amount" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtAmount" Style="{StaticResource InputTextBox}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNotes" Style="{StaticResource InputTextArea}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnClear" Content="Clear" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnClear_Click"/>
                        <Button x:Name="BtnSave" Content="Save" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Search / filter -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Search by person or description" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtSearch" Style="{StaticResource InputTextBox}" TextChanged="TxtSearch_TextChanged"/>
            </StackPanel>

            <local:DateFilterBar Grid.Column="2" x:Name="Filter" FilterChanged="Filter_FilterChanged"/>
        </Grid>

        <!-- Grid -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="TransactionsGrid" Style="{StaticResource ProDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MMM-yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Person / Karigar" Binding="{Binding PersonName}" Width="180"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="200"/>
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                            Margin="0,0,6,0" Click="EditRow_Click"/>
                                    <Button Content="Delete" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11"
                                            Click="DeleteRow_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
