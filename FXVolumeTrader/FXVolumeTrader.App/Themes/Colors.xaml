<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base dark surfaces -->
    <Color x:Key="BackgroundColor">#FF0E1117</Color>
    <Color x:Key="SurfaceColor">#FF161B22</Color>
    <Color x:Key="SurfaceAltColor">#FF1F2530</Color>
    <Color x:Key="BorderColor">#FF2A313D</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFE6E9EF</Color>
    <Color x:Key="TextSecondaryColor">#FF8B95A5</Color>
    <Color x:Key="TextDisabledColor">#FF4F5866</Color>

    <!-- Semantic trading colors -->
    <Color x:Key="BullishColor">#FF1FB874</Color>
    <Color x:Key="BullishDimColor">#FF15794D</Color>
    <Color x:Key="BearishColor">#FFE5484D</Color>
    <Color x:Key="BearishDimColor">#FF992F33</Color>
    <Color x:Key="WarningColor">#FFE8B339</Color>
    <Color x:Key="NeutralColor">#FF8B95A5</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#FF3D8BFD</Color>
    <Color x:Key="AccentDimColor">#FF2A5FA8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="BullishBrush" Color="{StaticResource BullishColor}" />
    <SolidColorBrush x:Key="BullishDimBrush" Color="{StaticResource BullishDimColor}" />
    <SolidColorBrush x:Key="BearishBrush" Color="{StaticResource BearishColor}" />
    <SolidColorBrush x:Key="BearishDimBrush" Color="{StaticResource BearishDimColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource NeutralColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />

</ResourceDictionary>
