{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/fxvolumetrader.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/fxvolumetrader-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AppSettings": {
    "DefaultTradingMode": "LiveSignalOnly",
    "Theme": "Dark"
  },
  "MarketData": {
    "Mock": {
      "TickIntervalMilliseconds": 400,
      "BasePrice": 1.08750,
      "VolatilityPerTick": 0.00006,
      "TypicalSpread": 0.00006
    },
    "CsvReplay": {
      "FilePath": "",
      "RealTimePlayback": false,
      "PlaybackSpeedMultiplier": 1.0,
      "MaxDelayBetweenTicks": "00:00:02"
    },
    "FeedHealth": {
      "MaxFeedDelaySeconds": 5,
      "MaxPriceGapPercentage": 1.0
    }
  }
}
