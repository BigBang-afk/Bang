<UserControl x:Class="FXVolumeTrader.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:FXVolumeTrader.App.Converters"
             xmlns:enums="clr-namespace:FXVolumeTrader.Core.Enums;assembly=FXVolumeTrader.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1300">

    <UserControl.Resources>
        <conv:SignalTypeToBrushConverter x:Key="SignalTypeToBrushConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:ConnectionStatusToBrushConverter x:Key="ConnectionStatusToBrushConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Dashboard" Style="{StaticResource PageTitleTextStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                         Fill="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusToBrushConverter}}" />
                <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Content="EMERGENCY STOP" Margin="20,0,0,0" Style="{StaticResource EmergencyStopButtonStyle}"
                        Command="{Binding EmergencyStopCommand}" />
            </StackPanel>
        </Grid>

        <!-- Asset / timeframe / expiry strip -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="ASSET" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding CurrentAsset}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="PRICE" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding CurrentPrice, StringFormat={}{0:0.00000}}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="TIMEFRAME" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding SelectedTimeframe}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="EXPIRY" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding SelectedExpiry}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="MARKET CONDITION" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding MarketCondition}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="TREND" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding CurrentTrend}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Main area: chart + signal panel -->
        <Grid Grid.Row="2" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Charts -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <TextBlock Text="Candlestick Chart" Style="{StaticResource SectionTitleTextStyle}"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" />
                        <lvc:CartesianChart Series="{Binding CandleSeries}"
                                             XAxes="{Binding CandleXAxes}"
                                             YAxes="{Binding CandleYAxes}"
                                             Margin="0,24,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <TextBlock Text="Tick Volume" Style="{StaticResource SectionTitleTextStyle}"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" />
                        <lvc:CartesianChart Series="{Binding VolumeSeries}"
                                             XAxes="{Binding VolumeXAxes}"
                                             YAxes="{Binding VolumeYAxes}"
                                             Margin="0,24,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Signal panel -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Signal" Style="{StaticResource SectionTitleTextStyle}" />

                    <Border Padding="12" CornerRadius="6" Margin="0,0,0,12"
                            Background="{Binding CurrentSignal, Converter={StaticResource SignalTypeToBrushConverter}}">
                        <TextBlock Text="{Binding CurrentSignal}" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="White" />
                    </Border>

                    <TextBlock Text="CALL CONFIDENCE" Style="{StaticResource LabelTextStyle}" />
                    <Grid Margin="0,2,0,10">
                        <ProgressBar Value="{Binding CallConfidence, Mode=OneWay}" Maximum="100" Height="8"
                                     Foreground="{StaticResource BullishBrush}" Background="{StaticResource SurfaceAltBrush}"
                                     BorderThickness="0" />
                        <TextBlock Text="{Binding CallConfidence, StringFormat={}{0}/100}" HorizontalAlignment="Right"
                                    Margin="0,-2,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <TextBlock Text="PUT CONFIDENCE" Style="{StaticResource LabelTextStyle}" />
                    <Grid Margin="0,2,0,10">
                        <ProgressBar Value="{Binding PutConfidence, Mode=OneWay}" Maximum="100" Height="8"
                                     Foreground="{StaticResource BearishBrush}" Background="{StaticResource SurfaceAltBrush}"
                                     BorderThickness="0" />
                        <TextBlock Text="{Binding PutConfidence, StringFormat={}{0}/100}" HorizontalAlignment="Right"
                                    Margin="0,-2,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <TextBlock Text="EXPLANATION" Style="{StaticResource LabelTextStyle}" Margin="0,6,0,2" />
                    <TextBlock Text="{Binding SignalExplanation}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10" />

                    <TextBlock Text="SUGGESTED TRADE AMOUNT" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding SuggestedTradeAmount, StringFormat={}${0:0.00}}"
                               Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />

                    <UniformGrid Columns="2" Rows="1">
                        <Button Content="Start Analysis" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,8"
                                Command="{Binding StartAnalysisCommand}" />
                        <Button Content="Stop Analysis" Style="{StaticResource RejectButtonStyle}" Margin="4,0,0,8"
                                Command="{Binding StopAnalysisCommand}" />
                    </UniformGrid>

                    <Button Content="Confirm CALL" Style="{StaticResource CallButtonStyle}" Margin="0,0,0,8"
                            Command="{Binding ConfirmCallCommand}" />
                    <Button Content="Confirm PUT" Style="{StaticResource PutButtonStyle}" Margin="0,0,0,8"
                            Command="{Binding ConfirmPutCommand}" />
                    <Button Content="Reject Signal" Style="{StaticResource RejectButtonStyle}"
                            Command="{Binding RejectSignalCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Session / risk stats -->
        <WrapPanel Grid.Row="3">
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="DAILY P/L" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding DailyProfitLoss, StringFormat={}${0:0.00}}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="WIN RATE" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding WinRate, StringFormat={}{0:0.0}%}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="CONSECUTIVE WINS" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding ConsecutiveWins}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="CONSECUTIVE LOSSES" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding ConsecutiveLosses}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="TRADES TODAY" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding TradesToday}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="DAILY LOSS LIMIT" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding DailyLossLimit, StringFormat={}${0:0.00}}" Style="{StaticResource ValueTextStyle}" />
                </StackPanel>
            </Border>
        </WrapPanel>
    </Grid>
</UserControl>
